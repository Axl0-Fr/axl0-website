/* Basestyles */
body {
  font-family: "Cartograph CF", Arial, Helvetica, sans-serif;
  background-image: var(--bg-tile);
  background-size: 302px 512px;
  background-position: 50%;
  background-repeat: repeat;
  background-attachment: fixed;
  position: relative;
  overflow-x: hidden;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 50%;
  z-index: 10;
  transform: translateX(-50%);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 8pt;
  background: color-mix(in srgb, var(--base) 50%, transparent);
  /* Same radius and blur as the dropdown panels. The top corners stay square
     because the bar is flush with the top of the viewport, like its items. */
  border-bottom-left-radius: 16pt;
  border-bottom-right-radius: 16pt;
  box-shadow: 0 4pt 24pt color-mix(in srgb, var(--base) 15%, transparent);
  padding: 0 8pt;
  height: 56pt;
  border-bottom: 3pt solid color-mix(in srgb, var(--surface0) 25%, transparent);
  border-left: 3pt solid color-mix(in srgb, var(--surface0) 25%, transparent);
  border-right: 3pt solid color-mix(in srgb, var(--surface0) 25%, transparent);
  backdrop-filter: blur(16pt);
  -webkit-backdrop-filter: blur(16pt);
}

.top-bar a {
  color: var(--overlay0);
  text-decoration: none;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 1px;
  padding: 4pt 8pt;
  /* Matches the dropdown item rows (8pt), square at the top since the item
     sits flush against the bar's top edge. */
  border-radius: 0 0 8pt 8pt;
  display: flex;
  flex-direction: column;
  transition:
    background 0.18s,
    color 0.18s;
  align-items: center;
  justify-content: center;
}

.top-bar a:hover {
  background: color-mix(in srgb, var(--overlay1) 25%, transparent);
  color: var(--overlay1);
}

.top-bar a.active {
  color: var(--overlay2);
  background: color-mix(in srgb, var(--overlay2) 25%, transparent);
}

.top-bar a i {
  font-size: 1.4rem;
  line-height: 1;
  margin: 4pt;
}

.hamburger {
  display: none;
  position: fixed;
  top: 12px;
  left: 16px;
  background: color-mix(in srgb, var(--base) 50%, transparent);
  border-radius: 8pt;
  z-index: 20;
  color: var(--overlay0);
  font-size: 2rem;
  border: 3pt solid color-mix(in srgb, var(--surface0) 25%, transparent);
  box-shadow: 0 4pt 24pt color-mix(in srgb, var(--base) 15%, transparent);
  /* Same box model as the theme toggle, so the 40px includes the border and
     both buttons render the same size. */
  box-sizing: border-box;
  width: 40px;
  height: 40px;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition:
    background 0.18s,
    color 0.18s;
  backdrop-filter: blur(16pt);
  -webkit-backdrop-filter: blur(16pt);
}

/* :focus-visible (not :focus) so the highlight drops as soon as the mouse
   leaves, matching the theme toggle. Clicking to open/close no longer leaves
   the button stuck in its highlighted state. */
.hamburger:hover,
.hamburger:focus-visible {
  background: color-mix(in srgb, var(--overlay1) 25%, transparent);
  color: var(--overlay1);
  backdrop-filter: blur(16pt);
  -webkit-backdrop-filter: blur(16pt);
}

.hamburger i {
  font-size: 1.2rem;
}

.hamburger.active {
  color: var(--overlay2);
  background: color-mix(in srgb, var(--overlay2) 25%, transparent);
}

/* Shared dropdown panel: the mobile nav and the theme picker are the same
   box, only the corner they hang from differs (data-placement). */
.dropdown-menu {
  display: none;
  flex-direction: column;
  position: fixed;
  top: 60px;
  background: color-mix(in srgb, var(--base) 50%, transparent);
  border-radius: 16pt;
  box-shadow: 0 6pt 24pt 0 color-mix(in srgb, var(--base) 15%, transparent);
  z-index: 30;
  min-width: 208px;
  padding: 1.5rem;
  gap: 0.75rem;
  align-items: flex-start;
  animation: fadeInMenu 0.18s;
  overflow: hidden;
  border: 3pt solid color-mix(in srgb, var(--surface0) 25%, transparent);
  backdrop-filter: blur(16pt);
  -webkit-backdrop-filter: blur(16pt);
}

.dropdown-menu.open {
  display: flex;
}

.dropdown-menu[data-placement="left"] {
  left: 16px;
}

.dropdown-menu[data-placement="right"] {
  right: 16px;
}

/* Same item look for both menus: the nav uses <a>, the theme picker <button> */
.dropdown-menu > a,
.dropdown-menu > button {
  color: var(--overlay0);
  text-decoration: none;
  background: none;
  border: none;
  padding: 0 1.5em;
  font-family: "Cartograph CF", Arial, Helvetica, sans-serif;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 1px;
  border-radius: 8pt;
  transition:
    background 0.18s,
    color 0.18s;
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  box-sizing: border-box;
  min-height: 48px;
  text-align: start;
  cursor: pointer;
}

.dropdown-menu > a:hover,
.dropdown-menu > button:hover {
  background: color-mix(in srgb, var(--overlay1) 25%, transparent);
  color: var(--overlay1);
}

.dropdown-menu > a.active,
.dropdown-menu > button.active {
  color: var(--overlay2);
  background: color-mix(in srgb, var(--overlay2) 25%, transparent);
}

.theme-toggle {
  display: flex;
  position: fixed;
  top: 12px;
  right: 16px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-sizing: border-box;
  min-width: 40px;
  height: 40px;
  background: color-mix(in srgb, var(--base) 50%, transparent);
  border-radius: 8pt;
  z-index: 20;
  color: var(--overlay0);
  font-family: "Cartograph CF", Arial, Helvetica, sans-serif;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 1px;
  border: 3pt solid color-mix(in srgb, var(--surface0) 25%, transparent);
  box-shadow: 0 4pt 24pt color-mix(in srgb, var(--base) 15%, transparent);
  cursor: pointer;
  transition:
    background 0.18s,
    color 0.18s;
  backdrop-filter: blur(16pt);
  -webkit-backdrop-filter: blur(16pt);
}

.theme-toggle:hover,
.theme-toggle:focus-visible {
  background: color-mix(in srgb, var(--overlay1) 25%, transparent);
  color: var(--overlay1);
}

.theme-toggle.active {
  color: var(--overlay2);
  background: color-mix(in srgb, var(--overlay2) 25%, transparent);
}

.theme-toggle i {
  font-size: 1.2rem;
}

.page-section {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 2rem;
  box-sizing: border-box;
}

@keyframes fadeInMenu {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (min-width: 513px) {
  .dropdown-menu[data-mobile-only] {
    display: none !important;
  }

  .socials-row {
    display: none !important;
  }
}

@media (max-width: 512px) {
  .top-bar {
    display: none;
  }

  .hamburger {
    display: flex;
  }

  /* The button stays in the top right corner (nothing else lives there), it
     only drops its label, same breakpoint as the topbar swap above. */
  .theme-toggle-label {
    display: none;
  }

  .socials-column {
    display: none !important;
  }
}

.button-group {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 16px;
}

.socials-column {
  display: inline-flexbox;
  justify-content: flex;
  gap: 8px;
  margin: 4pt 8pt;
}

.button-primary,
.button-secondary,
.button-tertiary,
.button-twitter,
.button-discord,
.button-youtube {
  border-radius: 8pt;
  padding: 12px 12px;
  font-size: 1rem;
  cursor: pointer;
  border: 2px solid;
  transition:
    background 0.2s,
    color 0.2s,
    border 0.2s;
  font-family: "Cartograph CF", Arial, Helvetica, sans-serif;
  font-style: italic;
  text-transform: capitalize;
  margin-top: 8px;
}

.button-primary {
  background-color: var(--surface2);
  color: var(--text);
  border-color: var(--surface2);
}

.button-primary:hover {
  background-color: transparent;
  color: var(--surface2);
}

.button-secondary {
  background-color: var(--surface1);
  color: var(--text);
  border-color: var(--surface1);
}

.button-secondary:hover {
  background-color: transparent;
  color: var(--surface1);
}

.button-tertiary {
  background-color: var(--surface0);
  color: var(--text);
  border-color: var(--surface0);
}

.button-tertiary:hover {
  background-color: transparent;
  color: var(--surface0);
}

.button-twitter {
  background-color: var(--sky);
  color: var(--crust);
  border-color: var(--sky);
}

.button-twitter:hover {
  background-color: transparent;
  color: var(--sky);
}

.button-discord {
  background-color: var(--blue);
  color: var(--crust);
  border-color: var(--blue);
}

.button-discord:hover {
  background-color: transparent;
  color: var(--blue);
}

.button-youtube {
