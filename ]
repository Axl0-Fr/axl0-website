  color: var(--crust);
  border-color: var(--red);
}

.button-youtube:hover {
  background-color: transparent;
  color: var(--red);
}

.hero-title {
  font-size: 4rem;
  font-weight: 700;
  color: var(--subtext1);
  text-shadow: 2pt 1pt 4pt color-mix(in srgb, var(--base) 15%, transparent);
  margin: 0;
  text-align: end;
}

.hero-subtitle {
  font-size: 1.5rem;
  color: var(--subtext0);
  text-shadow: 2pt 1pt 4pt color-mix(in srgb, var(--base) 15%, transparent);
  font-style: italic;
  text-align: end;
}

h2 {
  font-size: 2.5rem;
  font-weight: 600;
  color: var(--subtext0);
  text-shadow: 2pt 1pt 4pt color-mix(in srgb, var(--base) 15%, transparent);
  margin: 2rem 0 1rem;
  text-align: end;
}

.paragraph {
  background: color-mix(in srgb, var(--base) 50%, transparent);
  border-radius: 16pt;
  box-shadow: 0 6pt 24pt 0 color-mix(in srgb, var(--base) 15%, transparent);
  padding: 1.5rem;
  border: 3pt solid color-mix(in srgb, var(--surface0) 25%, transparent);
  backdrop-filter: blur(16pt);
  -webkit-backdrop-filter: blur(16pt);
  color: var(--text);
  max-width: 600px;
  margin: 2rem auto;
}

.paragraph p {
  margin-top: 0;
  text-align: justify;
}

.paragraph a {
  display: inline-block;
  color: var(--lavender);
  text-decoration: none;
}

.paragraph a:hover {
  color: var(--mauve);
}

.paragraph-socials {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  background: color-mix(in srgb, var(--base) 50%, transparent);
  border-radius: 16pt;
  box-shadow: 0 6pt 24pt 0 color-mix(in srgb, var(--base) 15%, transparent);
  padding: 1.5rem;
  border: 3pt solid color-mix(in srgb, var(--surface0) 25%, transparent);
  backdrop-filter: blur(16pt);
  -webkit-backdrop-filter: blur(16pt);
  color: var(--text);
  max-width: 600px;
  margin: 2rem auto;
}

.paragraph-socials p {
  margin-top: 0;
  text-align: start;
  flex: 1;
}

.paragraph-socials .socials-column {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.socials-row {
  display: flex;
  flex-direction: row;
  gap: 8px;
}

.footer-section {
  min-height: 5vh;
}

.footer-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 8pt;
  border: 3pt solid color-mix(in srgb, var(--surface0) 25%, transparent);
  color: var(--text);
  text-align: center;
  font-size: 0.8rem;
  line-height: 1.5;
  max-width: 100vw;
  margin: 0 auto;
  box-shadow: 0 6pt 24pt 0 color-mix(in srgb, var(--base) 15%, transparent);
  -webkit-box-shadow: 0 6pt 24pt 0
    color-mix(in srgb, var(--base) 15%, transparent);
  background-color: color-mix(in srgb, var(--base) 25%, transparent);
  backdrop-filter: blur(16pt);
  -webkit-backdrop-filter: blur(16pt);
}

.footer-content a {
  color: var(--mauve);
  text-decoration: none;
}

.footer-content a:hover {
  color: var(--lavender);
}
